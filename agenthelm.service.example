# Copy to ~/.config/systemd/user/agenthelm.service, edit paths, then:
#   systemctl --user daemon-reload && systemctl --user enable --now agenthelm
[Unit]
Description=AgentHelm

[Service]
ExecStart=/usr/bin/node %h/agenthelm/server.js
Restart=always
Environment=IDLE_DAYS=30
# Environment=JIRA_BASE=https://yourco.atlassian.net/browse/
# Environment=TICKET_PREFIXES=ABC,PROJ

[Install]
WantedBy=default.target
